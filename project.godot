; Godot 工程配置；玩法数值统一读取 config/game_config.json。
config_version=5

[application]
config/name="高考冲刺七天"
config/description="和同学一起学习、开小差的校园挂机游戏"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=33333

[autoload]
BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"

[display]
window/size/viewport_width=384
window/size/viewport_height=320
window/size/window_width_override=384
window/size/window_height_override=320
window/size/resizable=false
window/size/borderless=true
window/size/transparent=true
window/energy_saving/keep_screen_on=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
viewport/transparent_background=true
